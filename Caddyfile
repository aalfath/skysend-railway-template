{
	admin off
	auto_https off
	persist_config off
}

(proxy) {
	reverse_proxy 127.0.0.1:3000 {
		# Railway's edge sets X-Real-IP to the visitor. SkySend takes the last X-Forwarded-For
		# entry from a trusted proxy (loopback), so hand it exactly that one address.
		header_up X-Forwarded-For {http.request.header.X-Real-IP}
		header_up X-Real-IP {http.request.header.X-Real-IP}
		flush_interval -1
	}
}

:{$PORT} {
	# Railway's health check. Answers without a password.
	handle /healthz {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:3000
	}

	# What recipients and request senders need, open to anyone with a link:
	# the page and its static files, downloads, notes, file-request uploads and inboxes.
	# Everything else (the upload page, creating uploads, notes and requests) needs the password.
	@open path /api/health /api/config /assets/* /branding/* /file/* /note/* /d/* /inbox/* /request/* /how /api/info/* /api/exists/* /api/password/* /api/download/* /api/inbox/* /auth/*
	@noteapi {
		path_regexp ^/api/note/[A-Za-z0-9_-]+(/view|/password)?$
		not method DELETE
	}
	@requestapi {
		path_regexp ^/api/request/[A-Za-z0-9_-]+(/.*)?$
		not path /api/request/limit
	}
	@static {
		method GET HEAD
		not path /api/*
		path_regexp ^/[A-Za-z0-9_./-]*[.][A-Za-z0-9]+$
	}

	handle @open {
		import proxy
	}
	handle @noteapi {
		import proxy
	}
	handle @requestapi {
		import proxy
	}
	handle @static {
		import proxy
	}

	handle {
		basic_auth {
			{$UPLOAD_USERNAME} {$UPLOAD_PASSWORD_HASH}
		}
		import proxy
	}
}
